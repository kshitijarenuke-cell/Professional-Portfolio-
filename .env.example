# ============================================================
# Portfolio CMS — Environment Variables Template
# ============================================================
# Copy this file to config.env (for the main server) and fill in real values.
# NEVER commit config.env or any .env file to Git.
# ============================================================

# Server
PORT=3000
NODE_ENV=production

# MongoDB Database
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Admin Credentials (used for initial DB seeding only)
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_secure_admin_password

# Cloudinary Storage (for CMS image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Resend Email (for contact form notifications)
RESEND_API_KEY=re_your_resend_api_key

# Allowed Client Origin (set to your deployed frontend URL in production)
CLIENT_URL=https://your-portfolio.vercel.app
